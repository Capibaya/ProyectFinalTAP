<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.controller.RecuperarPasswordController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #1A237E;">

    <!-- Encabezado -->
    <VBox alignment="CENTER" spacing="6"
          style="-fx-padding: 30 40 20 40;">
        <Label text="🔑"
               style="-fx-font-size: 36px;"/>
        <Label text="RECUPERAR CONTRASEÑA"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Sistema de Gestión Hotelera"
               style="-fx-font-size: 12px; -fx-text-fill: #90CAF9;"/>
    </VBox>

    <!-- Barra de progreso de pasos -->
    <HBox alignment="CENTER" spacing="0"
          style="-fx-padding: 0 60 20 60;">
        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPaso1Num" text="1"
                   style="-fx-background-color: #42A5F5; -fx-text-fill: white;
                          -fx-font-weight: bold; -fx-font-size: 14px;
                          -fx-background-radius: 50; -fx-min-width: 32;
                          -fx-min-height: 32; -fx-alignment: center;"/>
            <Label text="Verificar usuario"
                   style="-fx-font-size: 10px; -fx-text-fill: #90CAF9;"/>
        </VBox>
        <Region style="-fx-background-color: #42A5F5; -fx-min-height: 2px;"
                HBox.hgrow="ALWAYS" maxHeight="2"/>
        <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPaso2Num" text="2"
                   style="-fx-background-color: #37474F; -fx-text-fill: #90A4AE;
                          -fx-font-weight: bold; -fx-font-size: 14px;
                          -fx-background-radius: 50; -fx-min-width: 32;
                          -fx-min-height: 32; -fx-alignment: center;"/>
            <Label text="Nueva contraseña"
                   style="-fx-font-size: 10px; -fx-text-fill: #546E7A;"/>
        </VBox>
    </HBox>

    <!-- Tarjeta principal -->
    <VBox fx:id="pnlTarjeta"
          spacing="14" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 30;
                 -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 16, 0, 0, 6);"
          maxWidth="360"
          VBox.vgrow="NEVER">

        <!-- ====== PASO 1: Verificar usuario ====== -->
        <VBox fx:id="pnlPaso1" spacing="12" alignment="CENTER">
            <Label text="Ingresa tu nombre de usuario"
                   style="-fx-font-size: 13px; -fx-text-fill: #546E7A;
                          -fx-wrap-text: true;" wrapText="true" maxWidth="300"/>

            <VBox spacing="4">
                <Label text="Nombre de usuario"
                       style="-fx-font-weight: bold; -fx-text-fill: #1A237E; -fx-font-size: 12px;"/>
                <TextField fx:id="txtUsuario" promptText="Escribe tu usuario"
                           prefWidth="300" style="-fx-font-size: 13px;
                           -fx-background-radius: 6; -fx-border-radius: 6;
                           -fx-border-color: #CFD8DC; -fx-border-width: 1;
                           -fx-padding: 8;"/>
            </VBox>

            <Label fx:id="lblError1" text="" wrapText="true" maxWidth="300"
                   style="-fx-font-size: 11px;"/>

            <Button fx:id="btnVerificar" text="VERIFICAR USUARIO"
                    prefWidth="300" prefHeight="40"
                    onAction="#handleVerificar"
                    style="-fx-background-color: #1565C0; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

        <!-- ====== PASO 2: Nueva contraseña ====== -->
        <VBox fx:id="pnlPaso2" spacing="12" alignment="CENTER" visible="false" managed="false">
            <Label fx:id="lblBienvenida" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #1565C0;
                          -fx-font-weight: bold;" wrapText="true" maxWidth="300"/>
            <Label text="Establece tu nueva contraseña"
                   style="-fx-font-size: 12px; -fx-text-fill: #546E7A;"/>

            <VBox spacing="4">
                <Label text="Nueva contraseña"
                       style="-fx-font-weight: bold; -fx-text-fill: #1A237E; -fx-font-size: 12px;"/>
                <PasswordField fx:id="txtNueva" promptText="Mínimo 6 caracteres"
                               prefWidth="300" style="-fx-font-size: 13px;
                               -fx-background-radius: 6; -fx-border-radius: 6;
                               -fx-border-color: #CFD8DC; -fx-border-width: 1;
                               -fx-padding: 8;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Confirmar contraseña"
                       style="-fx-font-weight: bold; -fx-text-fill: #1A237E; -fx-font-size: 12px;"/>
                <PasswordField fx:id="txtConfirmar" promptText="Repite la contraseña"
                               prefWidth="300" style="-fx-font-size: 13px;
                               -fx-background-radius: 6; -fx-border-radius: 6;
                               -fx-border-color: #CFD8DC; -fx-border-width: 1;
                               -fx-padding: 8;"/>
            </VBox>



            <Label fx:id="lblError2" text="" wrapText="true" maxWidth="300"
                   style="-fx-font-size: 11px;"/>

            <Button fx:id="btnCambiar" text="GUARDAR NUEVA CONTRASEÑA"
                    prefWidth="300" prefHeight="40"
                    onAction="#handleCambiarPassword"
                    style="-fx-background-color: #2E7D32; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>

    </VBox>

    <!-- Botón volver -->
    <Button fx:id="btnVolver" text="← Volver al inicio de sesión"
            onAction="#handleVolver"
            style="-fx-background-color: transparent; -fx-text-fill: #90CAF9;
                   -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;
                   -fx-border-color: transparent; -fx-padding: 16 0 30 0;"
            VBox.vgrow="NEVER"/>
</VBox>
